#!/usr/bin/env bash
# Mirrors the cheap CI jobs. Bypass for a scoped exception with `git push --no-verify`.
# git exports GIT_DIR (and friends) to hooks; a test that runs `git init` in a temp folder would then
# act on THIS repository (it once flipped core.bare). Drop them before running anything.
while IFS='=' read -r name _; do
  case "$name" in GIT_*) unset "$name" ;; esac
done < <(env)
exec make check
